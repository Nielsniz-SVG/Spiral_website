# Spiral Website - Configuration Example
# Copier ce fichier en .env.local et remplacer par vos vraies valeurs
# IMPORTANT: Ne jamais commiter de vraies clés sur GitHub !

# Supabase Configuration
# Obtenez ces valeurs depuis https://app.supabase.com

# URL de votre projet Supabase
# Format: https://[PROJECT-ID].supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Clé publique (Anon Key) - Sûre à mettre en public
# Trouvez-la dans Settings > API > Project API keys
SUPABASE_KEY=your-anon-key-here

# Optional: Service Role Key (CONFIDENTIAL - jamais en front-end !)
# À utiliser uniquement dans des fonctions serveur (Netlify Functions)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site Configuration
SITE_NAME=Spiral
SITE_URL=http://localhost:8000
